{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "websearch": "ask"
    },
    "tools": {
        "websearch": true
    },
    "mcp": {
        "playwright": {
            "type": "local",
            "command": [
                "npx",
                "@playwright/mcp@latest"
            ],
            "enabled": true
        }
    }
}